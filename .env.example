# ============================================
# Ticket Hunter 环境变量
# 复制为 .env 并修改实际值
# ============================================

# ---- 数据库 ----
TICKET_DB_PASSWORD=ticket_dev
DATABASE_URL=postgresql://ticket:ticket_dev@localhost:5433/ticket_hunter

# ---- Redis ----
REDIS_URL=redis://localhost:6380

# ---- JWT ----
TICKET_JWT_SECRET=change-me-to-a-random-64-char-string
JWT_SECRET=change-me-to-a-random-64-char-string

# ---- 加密 (生产环境必须用 KMS，此处为开发默认值) ----
ENCRYPTION_KEY=change-me-32-byte-key!!!!!!!!!!!!
ID_SALT=change-me-id-salt

# ---- 服务端口 ----
PORT=4000
NODE_ENV=development
