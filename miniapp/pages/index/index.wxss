/* pages/index/index.wxss */
.container { padding: 16rpx 24rpx; }
.search-bar { display: flex; margin-bottom: 16rpx; }
.search-input { flex: 1; background: #1a1a2e; color: #fff; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.search-btn { margin-left: 16rpx; background: #e94560; color: #fff; font-size: 28rpx; border-radius: 8rpx; padding: 0 32rpx; }

.category-scroll { white-space: nowrap; margin-bottom: 12rpx; }
.category { display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx; border-radius: 20rpx; font-size: 24rpx; background: #1a1a2e; color: #888; }
.category.active { background: #e94560; color: #fff; }

.city-bar { margin-bottom: 20rpx; }
.city-picker { display: inline-flex; align-items: center; padding: 12rpx 24rpx; background: #1a1a2e; border-radius: 8rpx; font-size: 26rpx; }
.arrow { margin-left: 8rpx; font-size: 20rpx; color: #888; }

.show-list { }
.show-card { display: flex; background: #1a1a2e; border-radius: 12rpx; margin-bottom: 20rpx; overflow: hidden; }
.poster { width: 180rpx; height: 240rpx; flex-shrink: 0; }
.card-info { flex: 1; padding: 16rpx; display: flex; flex-direction: column; justify-content: space-between; }
.show-title { font-size: 30rpx; font-weight: 600; color: #fff; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.show-meta { font-size: 24rpx; color: #aaa; margin-top: 4rpx; }
.show-time { font-size: 24rpx; color: #e94560; margin-top: 4rpx; }
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.tag { background: rgba(233,69,96,0.15); color: #e94560; padding: 4rpx 12rpx; border-radius: 4rpx; font-size: 20rpx; }
.sale-time { font-size: 22rpx; color: #888; }

.loading-more, .no-more, .empty { text-align: center; padding: 32rpx; color: #666; font-size: 24rpx; }
