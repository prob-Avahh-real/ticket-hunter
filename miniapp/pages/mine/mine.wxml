<!--pages/mine/mine.wxml-->
<view class="container">
  <!-- 用户头 -->
  <view class="user-header" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" />
    <view class="user-name">{{userInfo.nickname || '用户'}}
      <text class="verified-badge" wx:if="{{userInfo.id_verified}}">✅ 已核验</text>
      <text class="verified-badge pending" wx:else>⚠️ 未核验</text>
    </view>
    <button class="logout-btn" bindtap="onLogout">退出</button>
  </view>
  <view class="user-header" wx:else>
    <image class="avatar" src="/images/default-avatar.png" />
    <view class="user-name">未登录</view>
    <button class="login-btn" bindtap="onLogin">登录</button>
  </view>

  <!-- 订单统计 -->
  <view class="stats" wx:if="{{userInfo}}">
    <view class="stat-item" data-status="" bindtap="onGoOrders">
      <text class="stat-num">{{orderStats.all}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-item" data-status="pending" bindtap="onGoOrders">
      <text class="stat-num pending">{{orderStats.pending}}</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-item" data-status="paid" bindtap="onGoOrders">
      <text class="stat-num paid">{{orderStats.paid}}</text>
      <text class="stat-label">已支付</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu" wx:if="{{userInfo}}">
    <view class="menu-item" bindtap="onGoOrders">
      <text>📋 我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoVerify">
      <text>🛡️ 实名核验</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text>🎫 我的票夹</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text>⚙️ 设置</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="version">
    <text>Ticket Hunter v1.0.0 MVP</text>
  </view>
</view>
