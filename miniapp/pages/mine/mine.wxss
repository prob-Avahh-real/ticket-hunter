/* pages/mine/mine.wxss */
.container { padding: 24rpx; }
.user-header { display: flex; align-items: center; padding: 32rpx; background: #1a1a2e; border-radius: 12rpx; margin-bottom: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #2a2a3e; }
.user-name { flex: 1; margin-left: 24rpx; font-size: 32rpx; color: #fff; }
.login-btn { background: #e94560; color: #fff; font-size: 26rpx; padding: 12rpx 32rpx; border-radius: 20rpx; }
.logout-btn { background: transparent; color: #888; font-size: 24rpx; padding: 8rpx 20rpx; border: 1rpx solid #444; border-radius: 16rpx; }
.verified-badge { display: block; font-size: 22rpx; color: #5cb85c; margin-top: 6rpx; }
.verified-badge.pending { color: #f0ad4e; }

.stats { display: flex; background: #1a1a2e; border-radius: 12rpx; padding: 24rpx 0; margin-bottom: 24rpx; }
.stat-item { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 40rpx; font-weight: 700; color: #fff; }
.stat-num.pending { color: #f0ad4e; }
.stat-num.paid { color: #5cb85c; }
.stat-label { font-size: 24rpx; color: #888; margin-top: 4rpx; }

.menu { background: #1a1a2e; border-radius: 12rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid rgba(255,255,255,0.05); font-size: 28rpx; color: #fff; }
.menu-item:last-child { border-bottom: none; }
.arrow { font-size: 32rpx; color: #555; }

.version { text-align: center; padding: 48rpx; color: #444; font-size: 22rpx; }
