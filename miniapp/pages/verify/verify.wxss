.container { padding: 48rpx; }
.header { text-align: center; margin-bottom: 60rpx; }
.icon { font-size: 80rpx; display: block; }
.title { display: block; font-size: 36rpx; font-weight: 700; color: #fff; margin-top: 16rpx; }
.subtitle { display: block; font-size: 26rpx; color: #888; margin-top: 8rpx; }
.form { background: #1a1a2e; border-radius: 12rpx; padding: 32rpx; margin-bottom: 48rpx; }
.field { margin-bottom: 32rpx; }
.label { display: block; font-size: 26rpx; color: #aaa; margin-bottom: 12rpx; }
.input { width: 100%; background: #0f0f1a; color: #fff; padding: 20rpx; border-radius: 8rpx; font-size: 30rpx; box-sizing: border-box; }
.notice { font-size: 22rpx; color: #c9a96e; line-height: 1.5; }
.submit-btn { width: 100%; background: #e94560; color: #fff; font-size: 32rpx; font-weight: 600; padding: 24rpx; border-radius: 40rpx; border: none; }
.submit-btn.disabled { opacity: 0.5; }
