/* pages/login/login.wxss */
.container { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 48rpx; }
.logo-area { text-align: center; margin-bottom: 80rpx; }
.logo { font-size: 120rpx; display: block; }
.app-name { display: block; font-size: 40rpx; font-weight: 700; color: #fff; margin-top: 16rpx; }
.subtitle { display: block; font-size: 26rpx; color: #888; margin-top: 8rpx; }
.login-area { width: 100%; }
.mock-login-btn { width: 100%; background: #e94560; color: #fff; font-size: 32rpx; font-weight: 600; padding: 24rpx; border-radius: 40rpx; border: none; }
.hint { display: block; text-align: center; color: #555; font-size: 22rpx; margin-top: 16rpx; }
