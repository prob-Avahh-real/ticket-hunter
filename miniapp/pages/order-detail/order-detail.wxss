/* pages/order-detail/order-detail.wxss */
.container { padding: 24rpx; }
.status-card { text-align: center; padding: 48rpx; background: #1a1a2e; border-radius: 12rpx; margin-bottom: 24rpx; }
.status-icon { font-size: 64rpx; display: block; }
.status-text { font-size: 32rpx; color: #fff; margin-top: 12rpx; }

.info-card { background: #1a1a2e; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.card-title { font-size: 28rpx; font-weight: 600; color: #fff; margin-bottom: 16rpx; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.info-row:last-child { border-bottom: none; }
.label { font-size: 26rpx; color: #888; }
.value { font-size: 26rpx; color: #fff; }
.price { color: #e94560; font-weight: 600; }

.item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.item:last-child { border-bottom: none; }
.item-name { font-size: 26rpx; color: #fff; }
.item-price { font-size: 26rpx; color: #e94560; }

.pay-btn { width: 100%; margin-top: 32rpx; background: #e94560; color: #fff; font-size: 32rpx; font-weight: 600; padding: 24rpx; border-radius: 40rpx; border: none; }
