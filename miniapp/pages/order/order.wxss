/* pages/order/order.wxss */
.container { padding: 16rpx 24rpx; }
.tab-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.tab { display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx; border-radius: 20rpx; font-size: 24rpx; background: #1a1a2e; color: #888; }
.tab.active { background: #e94560; color: #fff; }

.order-list { }
.order-card { display: flex; background: #1a1a2e; border-radius: 12rpx; margin-bottom: 20rpx; padding: 16rpx; position: relative; }
.order-poster { width: 140rpx; height: 180rpx; border-radius: 8rpx; flex-shrink: 0; }
.order-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; justify-content: space-between; }
.order-title { font-size: 28rpx; font-weight: 600; color: #fff; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.order-meta { font-size: 22rpx; color: #aaa; }
.order-bottom { display: flex; justify-content: space-between; align-items: center; }
.order-amount { font-size: 30rpx; font-weight: 600; color: #e94560; }
.order-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.status-pending { color: #f0ad4e; background: rgba(240,173,78,0.1); }
.status-paid { color: #5cb85c; background: rgba(92,184,92,0.1); }
.status-cancelled { color: #888; background: rgba(136,136,136,0.1); }

.pay-btn { position: absolute; right: 16rpx; bottom: 16rpx; background: #e94560; color: #fff; font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 20rpx; }

.loading-more, .empty { text-align: center; padding: 64rpx; color: #666; font-size: 24rpx; }
