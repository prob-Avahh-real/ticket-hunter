/* pages/show/show.wxss */
.container { padding-bottom: 120rpx; }
.hero-poster { width: 100%; height: 480rpx; }

.info-section { padding: 24rpx; }
.show-name { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx; }
.show-tags { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.tag { background: rgba(233,69,96,0.15); color: #e94560; padding: 4rpx 16rpx; border-radius: 4rpx; font-size: 22rpx; }
.meta-row { font-size: 26rpx; color: #aaa; margin-bottom: 12rpx; }
.desc { font-size: 26rpx; color: #888; line-height: 1.6; }

.section { padding: 24rpx; border-top: 1rpx solid rgba(255,255,255,0.05); }
.section-title { font-size: 28rpx; font-weight: 600; color: #fff; margin-bottom: 16rpx; }
.session-picker { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #1a1a2e; border-radius: 8rpx; font-size: 28rpx; }
.arrow { color: #888; font-size: 20rpx; }

.ticket-list { }
.ticket-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.ticket-name { font-size: 28rpx; color: #fff; display: block; }
.ticket-price { font-size: 28rpx; color: #e94560; font-weight: 600; margin-right: 16rpx; }
.ticket-stock { font-size: 22rpx; color: #888; }
.citizen-badge { display: inline-block; margin-left: 8rpx; padding: 2rpx 10rpx; border-radius: 4rpx; font-size: 20rpx; background: rgba(201,169,110,0.2); color: #c9a96e; }
.citizen-badge.open { background: rgba(92,184,92,0.15); color: #5cb85c; }
.qty-control { display: flex; align-items: center; gap: 16rpx; }
.qty-btn { width: 52rpx; height: 52rpx; border-radius: 50%; background: #2a2a3e; color: #fff; font-size: 32rpx; display: flex; align-items: center; justify-content: center; line-height: 1; padding: 0; }
.qty-btn[disabled] { opacity: 0.3; }
.qty-num { font-size: 32rpx; color: #fff; min-width: 40rpx; text-align: center; }

.bottom-bar { position: fixed; bottom: 0; width: 100%; background: #1a1a2e; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.price-total { }
.total-label { font-size: 24rpx; color: #888; display: block; }
.total-amount { font-size: 40rpx; font-weight: 700; color: #e94560; }
.snatch-btn { background: #e94560; color: #fff; font-size: 30rpx; font-weight: 600; padding: 16rpx 48rpx; border-radius: 40rpx; border: none; }
.snatch-btn.disabled { opacity: 0.5; }

/* pass-bundles */
.bundle-list { }
.bundle-item { display: flex; background: #0f0f1a; border-radius: 8rpx; padding: 16rpx; margin-bottom: 12rpx; align-items: center; }
.bundle-poster { width: 80rpx; height: 100rpx; border-radius: 6rpx; flex-shrink: 0; }
.bundle-info { margin-left: 16rpx; flex: 1; }
.bundle-name { font-size: 26rpx; color: #fff; display: block; }
.bundle-venue { font-size: 22rpx; color: #aaa; margin-top: 4rpx; display: block; }
.bundle-visits { font-size: 20rpx; color: #c9a96e; margin-top: 4rpx; display: block; }
